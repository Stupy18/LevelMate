# Copy this to .env and fill in your values.
# HOST_IP is only needed for Expo Go on a physical device.
# For simulators on the same machine you can leave it as localhost.
HOST_IP=your-lan-ip-here

# Optional: authenticates the Expo CLI inside the Docker container non-interactively.
# Generate at https://expo.dev/settings/access-tokens (while logged into the same
# Expo account as your Expo Go app). Without this, the CLI runs anonymously — that
# still works, but manifest signing may show warnings if Expo Go is signed in.
EXPO_TOKEN=
